# Copy this file to .env and replace the values with your own.
PORT=3000
CONTACT_RECIPIENT=yourteam@bluskyfincorp.com
FROM_EMAIL=no-reply@bluskyfincorp.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

ADMIN_USER=admin
ADMIN_PASS=admin123
SSL_KEY=path/to/ssl.key
SSL_CERT=path/to/ssl.crt
